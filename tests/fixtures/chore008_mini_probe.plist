<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CHORE-008 fixture: the EXP-001 Mini plist (packaging/launchd/com.congruentsys.quotabus-probe.plist) as CHORE-007
     changed it (71bebe7): StartInterval is the 300 s tick. Verbatim otherwise, except HAZ-004 (ruled test edit):
     Mini's measured user is hankh19, so the binary, config and logs are under /Users/hankh19 (user-owned, no sudo). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.congruentsys.quotabus-probe</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/doppler</string>
        <string>run</string>
        <string>--project</string>
        <string>nusy-product-team</string>
        <string>--config</string>
        <string>dev</string>
        <string>--</string>
        <string>/Users/hankh19/.local/bin/quotabus</string>
        <string>probe</string>
        <string>--config</string>
        <string>/Users/hankh19/.config/quotabus/quotabus.toml</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/hankh19/Library/Logs/quotabus/probe.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hankh19/Library/Logs/quotabus/probe.err.log</string>
</dict>
</plist>
